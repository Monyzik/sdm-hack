# Основная LLM: любой провайдер с /chat/completions и tool calling.
# URL включает префикс API, например https://llm-provider.example/v1.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# tool_calling: схема в параметрах функции, аргументы проверяет Pydantic.
# json_schema: строгий response_format только при поддержке провайдером.
# Для конфигурации Z.ai в демке используется tool_calling.
LLM_RESPONSE_FORMAT=tool_calling
LLM_TIMEOUT_SECONDS=60
# Лимит генерации на один вызов модели, включая рассуждения провайдера.
LLM_MAX_OUTPUT_TOKENS=8192
LLM_MAX_RETRIES=2
# false оставляет sampling провайдеру; GLM-5.3-Flash рекомендует temperature=1.
LLM_SEND_TEMPERATURE=false
# Опциональные параметры reasoning. Включайте только у совместимого провайдера.
LLM_REASONING_EFFORT=
LLM_THINKING_MODE=
LLM_TOOL_STREAM=false
# Raw reasoning_content может содержать проектные данные и системный контекст.
LLM_EXPOSE_REASONING=false

# Реранкинг RRF-кандидатов той же LLM перед ответом QA. SSE показывает этап.
RAG_RERANK_ENABLED=true
RAG_RERANK_CANDIDATES=16
RAG_RERANK_TIMEOUT_SECONDS=30

# RAG: независимый провайдер с /embeddings, отдельные URL и ключ.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIMENSIONS=4096
# Инструкция добавляется только к запросу. Пустое значение отключает её,
# если провайдер сам форматирует Qwen query instruction.
EMBEDDING_QUERY_INSTRUCTION="Given a web search query, retrieve relevant passages that answer the query"
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_BASE_DELAY_SECONDS=1.0

# PostgreSQL
POSTGRES_DB=sdm_hack
POSTGRES_USER=sdm_hack
POSTGRES_PASSWORD=sdm_hack_password
POSTGRES_HOST=localhost
POSTGRES_INTERNAL_HOST=postgres
POSTGRES_PORT=5432
# Именованный volume; для существующей локальной БД можно указать её каталог.
POSTGRES_DATA_SOURCE=postgres_data

# Подключение с хост-машины
DATABASE_URL=postgresql://sdm_hack:sdm_hack_password@localhost:5432/sdm_hack

# Подключение из сервисов docker-compose
DATABASE_URL_DOCKER=postgresql://sdm_hack:sdm_hack_password@postgres:5432/sdm_hack

# Бэкенд
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# Фронтенд
FRONTEND_PORT=5180
VITE_API_URL=http://localhost:8000
VITE_AGENTS_API_URL=http://localhost:8010

# Agents
AGENTS_PORT=8010
# Жёсткий потолок на весь QA-запрос (ask/stream), секунды.
# Общий лимит запроса. Индекс проекта стоит подготовить до демонстрации.
# Дополнительный поиск запускается, только если осталось хотя бы 60 секунд.
AGENTS_REQUEST_BUDGET_SECONDS=180
AGENTS_CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
LOCAL_API_URL=http://localhost:8000
